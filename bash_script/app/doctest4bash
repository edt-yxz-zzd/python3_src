function doctest4bash
{
  local path4testfile
  local -i exit_status=0
  local -i r=0
  for path4testfile ; do
    ! : __DEBUG__ && echo >&2 "path4testfile-begin:${path4testfile@Q}"
    _doctest4bash "$path4testfile"
    r=$?
    ! : __DEBUG__ && echo >&2 "path4testfile-end:${path4testfile@Q}"
    (( r == 0 )) || exit_status=1
  done
  return "$exit_status"
}


function expand_shopt4instance_
{
  if [[ ! $# -eq 1 ]] ; then
    echo >&2 "$FUNCNAME: [num_args != 1]"
    return 1
  fi
  local pattern='^[_[:alnum:]]+(,[_[:alnum:]]+)*$'
  local shopt4instance="$1"
  [[ -n "$shopt4instance" ]] || return 0
  if [[ ! "$shopt4instance" =~ $pattern ]] ; then
    echo >&2 "$FUNCNAME: shopt4instance not match regex${pattern@Q}: ${shopt4instance@Q}"
    return 2
  elif [[ ! "$shopt4instance" =~ , ]] ; then
    echo "-O $shopt4instance"
  else
    echo "$(eval "echo '-O '{${shopt4instance}}")"
  fi
  return 0
}


