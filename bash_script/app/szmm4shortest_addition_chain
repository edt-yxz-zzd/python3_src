function lines5args() {
  local x
  for x ; do
    printf '%s\n' "$x"
  done
}
function check_args4main() {
  local -i exit_status=0
  #local -i u # ==>> always show:"bad arg: 0"
  local u
  for u ; do
    if ! [[ "$u" =~ ^[1-9][0-9]*$ ]] ; then
      echo >&2 "bad arg: ${u@Q}"
      exit_status=2
      break
    #.elif ! [[ "$u" -gt "$v" ]] ; then
    #.  echo >&2 "not ascending: not [${v@Q} < ${u@Q}]"
    #.  exit_status=3
    #.  break
    elif ! [[ "$u" -le 100000 ]] ; then
      echo >&2 "not [${u@Q} < 100000]"
      exit_status=4
      break
    fi
  done
  return "$exit_status"
}
function main__ver1() {
  check_args4main "$@"
  local -i exit_status=$?

  if [[ "$exit_status" -eq 0 ]] ; then

    local IFS=$'\n'
    local -i v=0
    local -i u

    for u in $(lines5args "$@" | sort -u -n) ; do
      exit_status=1 # for "not found"
      if [[ "$v" -eq 0 ]] ; then
        #skip to data
        while read -r -d $'\n' -u 0 line ; do
          ! : && echo >&2 "__DEBUG__: skip: ${line@Q}"
          if [[ "$line" == "(None" ]] ; then
            break
          fi
        done
      fi
      v="$u"
      while read -r -d $'\n' -u 0 line ; do
        ! : && echo >&2 "__DEBUG__: ${line@Q}"
        if ! [[ "$line" =~ ^,([0-9][0-9]*)"#"([0-9][0-9]*)$ ]] ; then
          exit_status=1 # for "not found"
          break
        #elif [[ "$line" =~ ^,([0-9][0-9]*)"#$u"$ ]] ; then
        elif [[ "${BASH_REMATCH[2]}" == "$u" ]] ; then
          echo "[ℓ($u) == ${BASH_REMATCH[1]}]"
          exit_status=0
          break
        fi
      done
      if ! [[ "$exit_status" -eq 0 ]] ; then
        # "not found"
        echo >&2 "LOGIC ERROR: ${u@Q}"
        exit_status=9
        break
      fi
    done
  fi

  if ! [[ "$exit_status" -eq 0 ]] ; then
    echo >&2 "$USAGE"
  fi
  return "$exit_status"
}



